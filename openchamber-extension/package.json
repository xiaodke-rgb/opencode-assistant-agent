{
  "name": "openchamber-assistant",
  "version": "0.2.3",
  "private": true,
  "description": "assistant 三件套 · OpenChamber 扩展：设置 + 守卫统计（面板直读配置文件，无后台服务）",
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.0.0"
    },
    "contributes": {
      "panel": {
        "id": "assistant",
        "name": "assistant 守卫",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "capabilities": ["sessions"],
      "filesystem": [
        "~/.config/opencode/assistant.json",
        "~/.config/opencode/assistant-counts.json"
      ],
      "attach": false
    }
  }
}
